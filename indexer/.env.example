# Copy to indexer/.env and fill in. Never commit indexer/.env.

# Required for backfill and start. Neon pooled connection string (host contains "-pooler").
DATABASE_URL=postgresql://your-user:your-password@your-endpoint-pooler.your-region.aws.neon.tech/your-db?sslmode=require

# Required for migrations only. Neon direct (non-pooled) connection string.
DATABASE_URL_UNPOOLED=postgresql://your-user:your-password@your-endpoint.your-region.aws.neon.tech/your-db?sslmode=require

# Optional. 3xpl JSON API token. Without it the indexer uses the keyless
# sandbox (rate limited, no uptime guarantee). With it, api.3xpl.com.
THREEXPL_API_KEY=your-3xpl-api-key

# Optional. 3xpl dumps token, used to download daily zcash-main event dumps
# from dumps.3xpl.com (for backfills).
THREEXPL_DUMPS_KEY=your-3xpl-dumps-key

# Optional. Minimum delay between API requests in milliseconds
# (default 2400 keyless, about 25 requests a minute; 1500 with a key).
THREEXPL_MIN_INTERVAL_MS=

# Optional. Minutes between collector cycles (default 10).
INTERVAL_MINUTES=10
